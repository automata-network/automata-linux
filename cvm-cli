#!/bin/bash

usage() {
    echo "Usage: ./cvm-cli <command> [options]"
    echo ""
    echo "Commands:"
    echo "  deploy-azure        Deploy a VM onto Azure using azure_disk.vhd."
    echo "  deploy-aws          Deploy a VM onto AWS using aws_disk.vmdk."
    echo "  deploy-gcp          Deploy a VM onto GCP using gcp_disk.tar.gz."
    echo "  update-workload     Update the workload on a deployed CVM."
    echo ""
    echo "Arguments for 'deploy-azure' command:"
    echo "  --vm_name <name>            The name of the virtual machine. Default: cvm_test"
    echo "                              This value is used to automatically derive:"
    echo "                                - resource_group   => <vm_name>_rg"
    echo "                                - storage_account  => sanitized lowercase form (max 24 chars)"
    echo "                                - gallery_name     => sanitized lowercase form (max 80 chars)"
    echo ""
    echo "  --additional_ports <ports>  Comma-separated list of additional ports to open (e.g., \"80,443\"). Default: None"
    echo "  --vm_type <type>            The type of VM to be deployed. Default: \"Standard_DC2es_v5\""
    echo "  --region <region>           The region where the VM will be deployed. Default: \"East US 2\""
    echo ""
    echo "  ⚠️  Do NOT provide --resource_group, --storage_account, or --gallery_name."
    echo "     These values are automatically derived from --vm_name to reduce config errors."
    echo ""
    echo "Arguments for 'deploy-gcp' command:"
    echo "  --project_id <id>           The project id for the deployment. **Mandatory**"
    echo "  --bucket <name>             The name of a gcp bucket to store the vm image to. **Mandatory**"
    echo "  --additional_ports <ports>  Comma-separated list of additional ports to open (e.g., \"80,443\"). Default: None"
    echo "  --vm_name <name>            The name of the virtual machine. Default: cvm-test"
    echo "  --region <region>           The region where the VM will be deployed. Default: \"asia-southeast1-b\""
    echo "  --vm_type <type>            The type of VM to be deployed. Default: \"c3-standard-4\""
    echo ""
    echo "Arguments for 'deploy-aws' command:"
    echo "  --bucket <name>             The name of an AWS bucket to store the vm image to. **Mandatory**"
    echo "  --additional_ports <ports>  Comma-separated list of additional ports to open (e.g., \"80,443\"). Default: None"
    echo "  --vm_name <name>            The name of the virtual machine. Default: cvm-test"
    echo "  --region <region>           The region where the VM will be deployed. Default: \"us-east-2\""
    echo "  --vm_type <type>            The type of VM to be deployed. Default: \"m6a.large\""
    echo ""
    exit 1
}

COMMAND=$1
shift 1  # Shift to process other arguments

if [[ -z "$COMMAND" ]]; then
    usage
fi

case "$COMMAND" in
    deploy-aws)
        VM_NAME="cvm-test"
        BUCKET=""
        REGION="us-east-2"
        VM_TYPE="m6a.large"
        ADDITIONAL_PORTS=""

        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --additional_ports)
                    ADDITIONAL_PORTS=$2
                    shift 2
                    ;;
                --vm_name)
                    VM_NAME=$2
                    shift 2
                    ;;
                --region)
                    REGION=$2
                    shift 2
                    ;;
                --vm_type)
                    VM_TYPE=$2
                    shift 2
                    ;;
                --bucket)
                    BUCKET=$2
                    shift 2
                    ;;
                *)
                    echo "Unknown argument: $1"
                    usage
                    ;;
            esac
        done

        # === Derive bucket name if not provided ===
        if [[ -z "$BUCKET" ]]; then
            SANITIZED_VM_NAME=$(echo "$VM_NAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
            RANDOM_SUFFIX=$(cat /dev/urandom | tr -dc 'a-z0-9' | fold -w6 | head -n1)
            BUCKET="${SANITIZED_VM_NAME:-cvm}${RANDOM_SUFFIX}"
            echo "ℹ️  No bucket provided. Using generated bucket name: $BUCKET"
        fi

        set -e
        # Check vm options
        ./scripts/check_options.sh "aws" "$VM_TYPE" "$REGION"
        # Ensure the disk image exists
        ./scripts/get_disk_image.sh "aws"
        # Update the disk image with the latest workload
        ./scripts/update_disk.sh "aws_disk.vmdk"
        # Check that CSP CLI dependencies are installed
        ./scripts/check_csp_deps.sh "aws"
        # Deploy the VM
        echo "Deploying aws_disk.vmdk with the following parameters:"
        echo "🔹VM Name: $VM_NAME"
        echo "🔹Region: $REGION"
        echo "🔹VM Type: $VM_TYPE"
        echo "🔹Bucket : $BUCKET"
        echo "🔹Additional Ports: $ADDITIONAL_PORTS"
        ./scripts/make_aws_vm.sh "$VM_NAME" "$REGION" "$VM_TYPE" "$BUCKET" "$ADDITIONAL_PORTS"
        ./scripts/get_golden_measurements.sh
        set +e
        ;;

    deploy-gcp)
        # Default values
        PROJECT_ID=""
        BUCKET=""
        VM_NAME="cvm-test"
        REGION="asia-southeast1-b"
        VM_TYPE="c3-standard-4"
        # To specify additional workload ports, pass them as a comma-separated string
        # eg. "80,443"
        ADDITIONAL_PORTS=""

        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --additional_ports)
                    ADDITIONAL_PORTS=$2
                    shift 2
                    ;;
                --vm_name)
                    VM_NAME=$2
                    shift 2
                    ;;
                --region)
                    REGION=$2
                    shift 2
                    ;;
                --project_id)
                    PROJECT_ID=$2
                    shift 2
                    ;;
                --vm_type)
                    VM_TYPE=$2
                    shift 2
                    ;;
                --bucket)
                    BUCKET=$2
                    shift 2
                    ;;
                *)
                    echo "Unknown argument: $1"
                    usage
                    ;;
            esac
        done

        # === Derive PROJECT_ID if not provided ===
        if [[ -z "$PROJECT_ID" ]]; then
            PROJECT_ID=$(gcloud config get-value project 2>/dev/null)
            if [[ -z "$PROJECT_ID" ]]; then
                echo "❌ PROJECT_ID not provided and no default found in gcloud config."
                exit 1
            fi
            echo "ℹ️  Using default gcloud project: $PROJECT_ID"
        fi


        # === Derive bucket name if not provided ===
        if [[ -z "$BUCKET" ]]; then
            SANITIZED_VM_NAME=$(echo "$VM_NAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
            RANDOM_SUFFIX=$(cat /dev/urandom | tr -dc 'a-z0-9' | fold -w6 | head -n1)
            BUCKET="${SANITIZED_VM_NAME:-cvm}${RANDOM_SUFFIX}"
            echo "ℹ️  No bucket provided. Using generated bucket name: $BUCKET"
        fi

        # === Derive region for GCS bucket creation ===
        BUCKET_REGION=$(echo "$REGION" | sed 's/-[a-z]$//')

        # === Ensure GCS bucket exists ===
        if gsutil ls -b "gs://${BUCKET}" 2>/dev/null; then
            echo "✅ Bucket gs://${BUCKET} already exists."
        else
            echo "⏳ Bucket gs://${BUCKET} does not exist. Creating it..."
            gcloud storage buckets create "gs://${BUCKET}" --location="$BUCKET_REGION" || {
                echo "❌ Failed to create bucket 'gs://${BUCKET}'."
                exit 1
            }
        fi

        set -e
        # Check vm options
        ./scripts/check_options.sh "gcp" "$VM_TYPE" "$REGION"
        # Ensure the disk image exists
        ./scripts/get_disk_image.sh "gcp"
        # Update the disk image with the latest workload
        ./scripts/update_disk.sh "gcp_disk.tar.gz"
        # Check that CSP CLI dependencies are installed
        ./scripts/check_csp_deps.sh "gcp"
        # Deploy the VM
        echo "Deploying gcp_disk.tar.gz with the following parameters:"
        echo "🔹VM Name: $VM_NAME"
        echo "🔹Region: $REGION"
        echo "🔹Project ID: $PROJECT_ID"
        echo "🔹VM Type: $VM_TYPE"
        echo "🔹Bucket : $BUCKET"
        echo "🔹Additional Ports: $ADDITIONAL_PORTS"
        ./scripts/make_gcp_vm.sh "$VM_NAME" "$REGION" "$PROJECT_ID" "$VM_TYPE" "$BUCKET" "$ADDITIONAL_PORTS"
        ./scripts/get_golden_measurements.sh
        set +e
        ;;

    deploy-azure)
        # Defaults
        VM_NAME="cvm_test"
        VM_TYPE="Standard_DC2es_v5"
        REGION="East US 2"
        ADDITIONAL_PORTS=""

        # Parse CLI args
        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                --additional_ports) ADDITIONAL_PORTS=$2; shift 2 ;;
                --vm_name) VM_NAME=$2; shift 2 ;;
                --vm_type) VM_TYPE=$2; shift 2 ;;
                --region) REGION=$2; shift 2 ;;
                --resource_group|--storage_account|--gallery_name)
                    echo "❌ Do not pass --$1 directly. It is derived from --vm_name."
                    exit 1
                    ;;
                *)
                    echo "Unknown argument: $1"
                    usage
                    ;;
            esac
        done

        # === Derive from VM_NAME ===
        RESOURCE_GROUP="${VM_NAME}_rg"

        STORAGE_ACC=$(echo "$VM_NAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9' | cut -c1-24)
        while [[ ${#STORAGE_ACC} -lt 3 ]]; do
            STORAGE_ACC="${STORAGE_ACC}0"
        done
        GALLERY_NAME=$(echo "$VM_NAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_.' | sed 's/^[_.]*//;s/[_.]*$//' | cut -c1-80)
        if [[ -z "$GALLERY_NAME" ]]; then
            GALLERY_NAME="default-gallery"
        fi


        set -e
        # Check vm options
        ./scripts/check_options.sh "azure" "$VM_TYPE" "$REGION"
        # Ensure the disk image exists
        ./scripts/get_disk_image.sh "azure"
        # Update the disk image with the latest workload
        ./scripts/update_disk.sh "azure_disk.vhd"
        # Check that CSP CLI dependencies are installed
        ./scripts/check_csp_deps.sh "azure"
        # Deploy the VM
        echo "Deploying azure_disk.vhd with the following parameters:"
        echo "🔹VM Name: $VM_NAME"
        echo "🔹Resource Group: $RESOURCE_GROUP"
        echo "🔹Region: $REGION"
        echo "🔹VM Type: $VM_TYPE"
        echo "🔹Additional Ports: $ADDITIONAL_PORTS"
        echo "🔹Storage Account: $STORAGE_ACC"
        echo "🔹Shared Image Gallery: $GALLERY_NAME"
        ./scripts/make_azure_vm.sh "$VM_NAME" "$RESOURCE_GROUP" "$VM_TYPE" "$ADDITIONAL_PORTS" "$STORAGE_ACC" "$GALLERY_NAME" "$REGION"
        ./scripts/get_golden_measurements.sh
        set +e
        ;;

    update-workload)
        set -e
        ./scripts/update_remote_workload.sh
        echo "Updating golden measurements..."
        ./scripts/get_golden_measurements.sh
        set +e
        ;;

    *)
        echo "Unknown command: $COMMAND"
        usage
        ;;
esac

exit 0
